#!/usr/bin/env bash

set -euo pipefail

_error() {
    logger -t "$(basename "$0")" -p user.err -- "$*"
    exit 1
}

_warn() {
    logger -t "$(basename "$0")" -p user.warning -- "$*"
}

_info() {
    logger -t "$(basename "$0")" -p user.info -- "$*"
}

_cpu_driver() {
    local driver
    if driver=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null); then
        echo "$driver"
    fi
}

_gpu_driver() {
    local driver
    if driver=$(readlink /sys/class/drm/card0/device/driver 2>/dev/null); then
        basename "$driver"
    fi
}

_cpu_temp() {
    local zone temp
    for zone in /sys/class/thermal/thermal_zone*/type; do
        if [ "$(cat "$zone" 2>/dev/null)" = "x86_pkg_temp" ]; then
            temp=$(cat "${zone%/type}/temp" 2>/dev/null)
            echo "$(( temp / 1000 ))°C"
            return
        fi
    done
    echo "-"
}

_apply_cpu() {
    local pct=$1
    case "$(_cpu_driver)" in
        "")
            _warn "CPU unsupported; CPU controls disabled"
            return
            ;;
        intel_pstate)
            echo "$pct" | sudo tee "$intel_pstate_max_perf_pct_path" > /dev/null
            ;;
        *)
            local target dir cpu_hw_max
            for dir in $cpu_freq_dir_glob; do
                cpu_hw_max=$(cat "${dir}cpuinfo_max_freq")
                target=$(( cpu_hw_max * pct / 100 ))
                echo "$target" | sudo tee "${dir}scaling_max_freq" > /dev/null
            done
            ;;
    esac
}

_apply_gpu() {
    local pct=$1
    case "$(_gpu_driver)" in
        xe)
            local dir rp0 rpn target
            for dir in $intel_xe_freq_dir_glob; do
                rp0=$(cat "${dir}rp0_freq")
                rpn=$(cat "${dir}rpn_freq")
                target=$(( pct * rp0 / 100 ))
                [ "$target" -lt "$rpn" ] && target=$rpn
                echo "$target" | sudo tee "${dir}max_freq" > /dev/null
            done
            ;;
        *)
            _warn "GPU unsupported; GPU controls disabled"
            return
            ;;
    esac
}

_init() {
    local sudoers_content="%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee ${cpu_freq_dir_glob}scaling_max_freq"

    case "$(_cpu_driver)" in
        intel_pstate)
            sudoers_content="$sudoers_content
%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee $intel_pstate_max_perf_pct_path"
            ;;
    esac

    case "$(_gpu_driver)" in
        xe)
            sudoers_content="$sudoers_content
%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee ${intel_xe_freq_dir_glob}max_freq"
            ;;
    esac

    if [ -f "$platform_profile_path" ]; then
        sudoers_content="$sudoers_content
%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee $platform_profile_path"
    fi

    sudo mkdir -p /etc/sudoers.d
    echo "$sudoers_content" | sudo tee /etc/sudoers.d/freq > /dev/null
    sudo chmod 0440 /etc/sudoers.d/freq
    sudo visudo -c -f /etc/sudoers.d/freq
    _info "sudoers config installed: /etc/sudoers.d/freq"
    exit 0
}

_reset() {
    sudo rm -f /etc/sudoers.d/freq
    _info "sudoers config removed: /etc/sudoers.d/freq"
    exit 0
}

_apply_profile() {
    local profile=$1
    if [ ! -f "$platform_profile_path" ]; then
        _warn "Platform profiles not supported; --profile ignored"
        return
    fi
    echo "$profile" | sudo tee "$platform_profile_path" > /dev/null
}

_help() {
    echo "Usage: ${0##*/} [normal|init|reset|--help] [-c <10-100>] [-g <10-100>] [-p <name>] [<10-100>]"
    echo ""
    echo "  normal        GPU=rp0_freq (max), CPU=unlimited"
    echo "  init          Install sudoers config (sudo tee permissions)"
    echo "  reset         Remove sudoers config"
    echo "  -c, --cpu <10-100>     Set CPU to percentage (overrides positional default)"
    echo "  -g, --gpu <10-100>     Set GPU to percentage (overrides positional default)"
    echo "  -p, --profile <name>   Set ACPI platform profile (quiet, balanced, performance, …)"
    echo "  <10-100>      Both CPU and GPU scaled to percentage (default if no flags)"
    echo ""
    echo "With no arguments, shows current status."
    echo ""
    echo "Examples:"
    echo "  ${0##*/} init"
    echo "  ${0##*/} reset"
    echo "  ${0##*/} normal"
    echo "  ${0##*/} 45"
    echo "  ${0##*/} --cpu 45"
    echo "  ${0##*/} --cpu 45 --gpu 60"
    echo "  ${0##*/} 45 --gpu 60"
    echo "  ${0##*/} --profile performance"
    echo "  ${0##*/} --profile quiet --cpu 70"
    exit 0
}

_show_cpu_line() {
    local dir=$1 cpu_max=$2 cpu_cap=$3 driver=$4 cpu_temp=$5
    local cpu_num cpu_cur governor cpu_cap_disp cpu_pct
    cpu_num=$(basename "$(dirname "$dir")"); cpu_num=${cpu_num#cpu}
    cpu_cur=$(cat "${dir}scaling_cur_freq")
    governor=$(cat "${dir}scaling_governor")

    cpu_cap_disp="-"
    if [ "$cpu_cap" -ne "$cpu_max" ]; then
        cpu_pct=$(( cpu_cap * 100 / cpu_max ))
        cpu_cap_disp="$(( cpu_cap / 1000 )) (${cpu_pct}%)"
    fi

    printf "CPU %2d: %-5d  %-12s  %-4d MHz %4s  %s / %s\n" \
        "$cpu_num" $(( cpu_cur / 1000 )) "$cpu_cap_disp" $(( cpu_max / 1000 )) "$cpu_temp" "$governor" "$driver"
}

_show_gpu_line() {
    local dir=$1
    local gpu_num gpu_cur gpu_cap gpu_max gpu_profile gpu_cap_disp gpu_pct line

    gpu_num=$(basename "$(dirname "$dir")"); gpu_num=${gpu_num#gt}
    gpu_cur=$(cat "${dir}cur_freq")
    gpu_cap=$(cat "${dir}max_freq")
    gpu_max=$(cat "${dir}rp0_freq")

    gpu_profile="-"
    if read -r line < "${dir}power_profile" 2>/dev/null; then
        [[ "$line" =~ \[([^]]+)\] ]] && gpu_profile="${BASH_REMATCH[1]}"
    fi

    gpu_cap_disp="-"
    if [ "$gpu_cap" -ne "$gpu_max" ]; then
        gpu_pct=$(( gpu_cap * 100 / gpu_max ))
        gpu_cap_disp="${gpu_cap} (${gpu_pct}%)"
    fi

    printf "GPU %2d: %-5d  %-12s  %-4d MHz %4s  %s / %s\n" \
        "$(( 10#${gpu_num} ))" "$gpu_cur" "$gpu_cap_disp" "$gpu_max" "-" "$gpu_profile" "xe"
}

_show_gpu_block() {
    local line
    case "$(_gpu_driver)" in
        xe)
            local dir
            for dir in $intel_xe_freq_dir_glob; do
                _show_gpu_line "$dir"
            done
            ;;
        *)
            printf "GPU   : unsupported\n"
            ;;
    esac
}

_show_profile() {
    local profile
    if profile=$(cat "$platform_profile_path" 2>/dev/null); then
        printf "Power profile: %s\n" "$profile"
    else
        printf "Power profile: N/A\n"
    fi
}

_show_cpu_block() {
    declare -A temp_map=()
    local pkg_temp coretemp_hwmon d label_file core_temp_id core_temp_value label

    for d in /sys/devices/platform/coretemp.*/hwmon/hwmon*/; do
        if [ -f "${d}temp1_label" ]; then
            coretemp_hwmon="$d"
            break
        fi
    done
    if [ -n "$coretemp_hwmon" ]; then
        for label_file in "${coretemp_hwmon}"temp*_label; do
            [ -f "$label_file" ] || continue
            label=$(cat "$label_file" 2>/dev/null) || continue
            if [[ "$label" =~ ^Core\ ([0-9]+)$ ]]; then
                core_temp_id="${BASH_REMATCH[1]}"
                core_temp_value=$(cat "${label_file%_label}_input" 2>/dev/null) || continue
                temp_map[$core_temp_id]="$(( core_temp_value / 1000 ))°C"
            fi
        done
    fi
    pkg_temp=$(_cpu_temp)

    case "$(_cpu_driver)" in
        "")
            printf "CPU   : unsupported\n"
            ;;
        intel_pstate)
            local dir cpu_num cpu_max cpu_cap cpu_max_perf_pct cpu_temp core_id
            for dir in $cpu_freq_dir_glob; do
                cpu_num=$(basename "$(dirname "$dir")"); cpu_num=${cpu_num#cpu}
                cpu_max=$(cat "${dir}cpuinfo_max_freq")
                cpu_cap=$cpu_max
                cpu_max_perf_pct=$(cat "$intel_pstate_max_perf_pct_path" 2>/dev/null)
                if [ -n "$cpu_max_perf_pct" ]; then
                    cpu_cap=$(( cpu_max * cpu_max_perf_pct / 100 ))
                fi
                core_id=$(cat "/sys/devices/system/cpu/cpu${cpu_num}/topology/core_id" 2>/dev/null)
                if [ -n "$core_id" ] && [[ -v temp_map[$core_id] ]]; then
                    cpu_temp="${temp_map[$core_id]}"
                else
                    cpu_temp="$pkg_temp"
                fi
                _show_cpu_line "$dir" "$cpu_max" "$cpu_cap" "intel_pstate" "$cpu_temp"
            done
            ;;
        *)
            local dir cpu_num cpu_max cpu_cap driver cpu_temp core_id
            driver=$(_cpu_driver)
            for dir in $cpu_freq_dir_glob; do
                cpu_num=$(basename "$(dirname "$dir")"); cpu_num=${cpu_num#cpu}
                cpu_max=$(cat "${dir}cpuinfo_max_freq")
                cpu_cap=$(cat "${dir}scaling_max_freq")
                core_id=$(cat "/sys/devices/system/cpu/cpu${cpu_num}/topology/core_id" 2>/dev/null)
                if [ -n "$core_id" ] && [[ -v temp_map[$core_id] ]]; then
                    cpu_temp="${temp_map[$core_id]}"
                else
                    cpu_temp="$pkg_temp"
                fi
                _show_cpu_line "$dir" "$cpu_max" "$cpu_cap" "$driver" "$cpu_temp"
            done
            ;;
    esac
}

_show_status() {
    local line line_buffer=""

    line_buffer+="$(_show_profile)"$'\n'
    printf -v line "        %-5s  %-12s  %-8s %4s  %s" cur cap "hw_max" temp info
    line_buffer+="$line"$'\n'

    line_buffer+="$(_show_cpu_block)"$'\n'
    line_buffer+="$(_show_gpu_block)"$'\n'

    printf '%s' "$line_buffer"
}

# Generic (works with any CPU scaling driver)
readonly cpu_freq_dir_glob="/sys/devices/system/cpu/cpu*/cpufreq/"

# intel_pstate-specific
readonly intel_pstate_max_perf_pct_path="/sys/devices/system/cpu/intel_pstate/max_perf_pct"

# intel_xe-specific
readonly intel_xe_freq_dir_glob="/sys/class/drm/card0/device/tile*/gt*/freq0/"

# platform profile (ACPI)
readonly platform_profile_path="/sys/firmware/acpi/platform_profile"
readonly platform_profile_choices_path="/sys/firmware/acpi/platform_profile_choices"

case "${1-}" in
    init)
        _init
        ;;
    reset)
        _reset
        ;;
    --help|-h)
        _help
        ;;
esac

main() {
    local positional="" cpu_pct="" gpu_pct="" profile=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            normal)
                [ -n "$cpu_pct" ] || cpu_pct=100
                [ -n "$gpu_pct" ] || gpu_pct=100
                ;;
            --cpu|-c)
                [ $# -ge 2 ] || _error "--cpu requires a value"
                [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 10 ] && [ "$2" -le 100 ] || _error "--cpu: invalid percentage '$2'"
                cpu_pct="$2"; shift
                ;;
            --gpu|-g)
                [ $# -ge 2 ] || _error "--gpu requires a value"
                [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 10 ] && [ "$2" -le 100 ] || _error "--gpu: invalid percentage '$2'"
                gpu_pct="$2"; shift
                ;;
            --profile|-p)
                [ $# -ge 2 ] || _error "--profile requires a value"
                profile="$2"; shift
                ;;
            *)
                if [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 10 ] && [ "$1" -le 100 ] && [ -z "$positional" ]; then
                    positional="$1"
                else
                    _error "invalid argument: $1"
                fi
                ;;
        esac
        shift
    done

    [ -z "$cpu_pct" ] && [ -n "$positional" ] && cpu_pct="$positional"
    [ -z "$gpu_pct" ] && [ -n "$positional" ] && gpu_pct="$positional"

    if [ -n "$profile" ]; then
        if [ ! -f "$platform_profile_choices_path" ]; then
            _warn "Platform profiles not supported; --profile ignored"
            profile=""
        else
            local choices c valid
            choices=$(cat "$platform_profile_choices_path")
            for c in $choices; do
                [ "$c" = "$profile" ] && valid=1 && break
            done
            [ -n "${valid-}" ] || _error "Invalid profile '$profile'. Available: $choices"
        fi
    fi

    if [ -z "$cpu_pct" ] && [ -z "$gpu_pct" ] && [ -z "$profile" ]; then
        _show_status
        exit 0
    fi

    [ -n "$cpu_pct" ] && _apply_cpu "$cpu_pct"
    [ -n "$gpu_pct" ] && _apply_gpu "$gpu_pct"
    [ -n "$profile" ] && _apply_profile "$profile"

    local log_msg=""
    [ -n "$cpu_pct" ] && log_msg="CPU@${cpu_pct}%"
    [ -n "$gpu_pct" ] && log_msg="${log_msg:+$log_msg, }GPU@${gpu_pct}%"
    [ -n "$profile" ] && log_msg="${log_msg:+$log_msg, }profile=$profile"
    _info "$log_msg"
}

main "$@"

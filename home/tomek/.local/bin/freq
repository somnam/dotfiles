#!/usr/bin/env bash

set -euo pipefail

_error() {
    logger -t "$(basename "$0")" -p user.err -- "$*"
    echo "$*" >&2
    exit 1
}

_warn() {
    logger -t "$(basename "$0")" -p user.warning -- "$*"
    echo "$*" >&2
}

_info() {
    logger -t "$(basename "$0")" -p user.info -- "$*"
    echo "$*" >&1
}

_cpu_driver() {
    local driver
    if driver=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null); then
        echo "$driver"
    fi
}

_gpu_driver() {
    local driver
    if driver=$(readlink /sys/class/drm/card0/device/driver 2>/dev/null); then
        basename "$driver"
    fi
}

_apply_cpu() {
    local pct=$1
    case "$(_cpu_driver)" in
        "")
            _warn "CPU unsupported; CPU controls disabled"
            return
            ;;
        intel_pstate)
            echo "$pct" | sudo tee "$intel_pstate_max_perf_pct_path" > /dev/null
            ;;
        *)
            local target dir cpu_hw_max
            for dir in $cpu_freq_dir_glob; do
                cpu_hw_max=$(cat "${dir}cpuinfo_max_freq")
                target=$(( cpu_hw_max * pct / 100 ))
                echo "$target" | sudo tee "${dir}scaling_max_freq" > /dev/null
            done
            ;;
    esac
}

_apply_gpu() {
    local pct=$1
    case "$(_gpu_driver)" in
        xe)
            local dir rp0 rpn target
            for dir in $intel_xe_freq_dir_glob; do
                rp0=$(cat "${dir}rp0_freq")
                rpn=$(cat "${dir}rpn_freq")
                target=$(( pct * rp0 / 100 ))
                [ "$target" -lt "$rpn" ] && target=$rpn
                echo "$target" | sudo tee "${dir}max_freq" > /dev/null
            done
            ;;
        *)
            _warn "GPU unsupported; GPU controls disabled"
            return
            ;;
    esac
}

_init() {
    local sudoers_content="%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee ${cpu_freq_dir_glob}scaling_max_freq"

    case "$(_cpu_driver)" in
        intel_pstate)
            sudoers_content="$sudoers_content
%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee $intel_pstate_max_perf_pct_path"
            ;;
    esac

    case "$(_gpu_driver)" in
        xe)
            sudoers_content="$sudoers_content
%wheel ALL=(root) NOPASSWD: SETENV: /usr/bin/tee ${intel_xe_freq_dir_glob}max_freq"
            ;;
    esac

    sudo mkdir -p /etc/sudoers.d
    echo "$sudoers_content" | sudo tee /etc/sudoers.d/freq > /dev/null
    sudo chmod 0440 /etc/sudoers.d/freq
    sudo visudo -c -f /etc/sudoers.d/freq
    _info "sudoers config installed: /etc/sudoers.d/freq"
    exit 0
}

_reset() {
    sudo rm -f /etc/sudoers.d/freq
    _info "sudoers config removed: /etc/sudoers.d/freq"
    exit 0
}

_help() {
    echo "Usage: ${0##*/} [normal|init|reset|--help] [--cpu <10-100>] [--gpu <10-100>] [<10-100>]"
    echo ""
    echo "  normal        GPU=rp0_freq (max), CPU=unlimited"
    echo "  init          Install sudoers config (sudo tee permissions)"
    echo "  reset         Remove sudoers config"
    echo "  --cpu <10-100> Set CPU to percentage (overrides positional default)"
    echo "  --gpu <10-100>  Set GPU to percentage (overrides positional default)"
    echo "  <10-100>      Both CPU and GPU scaled to percentage (default if no flags)"
    echo ""
    echo "With no arguments, shows current status."
    echo ""
    echo "Examples:"
    echo "  ${0##*/} init"
    echo "  ${0##*/} reset"
    echo "  ${0##*/} normal"
    echo "  ${0##*/} 45"
    echo "  ${0##*/} --cpu 45"
    echo "  ${0##*/} --cpu 45 --gpu 60"
    echo "  ${0##*/} 45 --gpu 60"
    exit 0
}

_show_cpu_line() {
    local dir=$1 cpu_max=$2 cpu_cap=$3 driver=$4
    local cpu_num cpu_cur governor cpu_cap_disp cpu_pct
    cpu_num=$(basename "$(dirname "$dir")"); cpu_num=${cpu_num#cpu}
    cpu_cur=$(cat "${dir}scaling_cur_freq")
    governor=$(cat "${dir}scaling_governor")

    cpu_cap_disp="-"
    if [ "$cpu_cap" -ne "$cpu_max" ]; then
        cpu_pct=$(( cpu_cap * 100 / cpu_max ))
        cpu_cap_disp="$(( cpu_cap / 1000 )) (${cpu_pct}%)"
    fi

    printf "CPU %2d: %-5d  %-12s  %-4d MHz  %s / %s\n" \
        "$cpu_num" $(( cpu_cur / 1000 )) "$cpu_cap_disp" $(( cpu_max / 1000 )) "$governor" "$driver"
}

_show_gpu_line() {
    local dir=$1
    local gpu_num gpu_cur gpu_cap gpu_max gpu_profile gpu_cap_disp gpu_pct line

    gpu_num=$(basename "$(dirname "$dir")"); gpu_num=${gpu_num#gt}
    gpu_cur=$(cat "${dir}cur_freq")
    gpu_cap=$(cat "${dir}max_freq")
    gpu_max=$(cat "${dir}rp0_freq")

    gpu_profile="-"
    if read -r line < "${dir}power_profile" 2>/dev/null; then
        [[ "$line" =~ \[([^]]+)\] ]] && gpu_profile="${BASH_REMATCH[1]}"
    fi

    gpu_cap_disp="-"
    if [ "$gpu_cap" -ne "$gpu_max" ]; then
        gpu_pct=$(( gpu_cap * 100 / gpu_max ))
        gpu_cap_disp="${gpu_cap} (${gpu_pct}%)"
    fi

    printf "GPU %2d: %-5d  %-12s  %-4d MHz  %s / %s\n" \
        "$(( 10#${gpu_num} ))" "$gpu_cur" "$gpu_cap_disp" "$gpu_max" "$gpu_profile" "xe"
}

_show_status() {
    local line line_buffer=""

    printf -v line "        %-5s  %-12s  %-6s    %s" cur cap hw_max info
    line_buffer+="$line"$'\n'

    case "$(_cpu_driver)" in
        "")
            printf -v line "CPU   : unsupported"
            line_buffer+="$line"$'\n'
            ;;
        intel_pstate)
            local dir cpu_max cpu_cap cpu_max_perf_pct
            for dir in $cpu_freq_dir_glob; do
                cpu_max=$(cat "${dir}cpuinfo_max_freq")
                cpu_cap=$cpu_max
                cpu_max_perf_pct=$(cat "$intel_pstate_max_perf_pct_path" 2>/dev/null)
                if [ -n "$cpu_max_perf_pct" ]; then
                    cpu_cap=$(( cpu_max * cpu_max_perf_pct / 100 ))
                fi
                line_buffer+="$(_show_cpu_line "$dir" "$cpu_max" "$cpu_cap" "intel_pstate")"$'\n'
            done
            ;;
        *)
            local dir cpu_max cpu_cap driver
            driver=$(_cpu_driver)
            for dir in $cpu_freq_dir_glob; do
                cpu_max=$(cat "${dir}cpuinfo_max_freq")
                cpu_cap=$(cat "${dir}scaling_max_freq")
                line_buffer+="$(_show_cpu_line "$dir" "$cpu_max" "$cpu_cap" "$driver")"$'\n'
            done
            ;;
    esac

    case "$(_gpu_driver)" in
        xe)
            local dir
            for dir in $intel_xe_freq_dir_glob; do
                line_buffer+="$(_show_gpu_line "$dir")"$'\n'
            done
            ;;
        *)
            printf -v line "GPU   : unsupported"
            line_buffer+="$line"$'\n'
            ;;
    esac

    printf '%s' "$line_buffer"
}

# Generic (works with any CPU scaling driver)
readonly cpu_freq_dir_glob="/sys/devices/system/cpu/cpu*/cpufreq/"

# intel_pstate-specific
readonly intel_pstate_max_perf_pct_path="/sys/devices/system/cpu/intel_pstate/max_perf_pct"

# intel_xe-specific
readonly intel_xe_freq_dir_glob="/sys/class/drm/card0/device/tile*/gt*/freq0/"

case "${1-}" in
    init)
        _init
        ;;
    reset)
        _reset
        ;;
    --help|-h)
        _help
        ;;
esac

main() {
    local positional="" cpu_pct="" gpu_pct=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            normal)
                [ -n "$cpu_pct" ] || cpu_pct=100
                [ -n "$gpu_pct" ] || gpu_pct=100
                ;;
            --cpu)
                [ $# -ge 2 ] || _error "--cpu requires a value"
                [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 10 ] && [ "$2" -le 100 ] || _error "--cpu: invalid percentage '$2'"
                cpu_pct="$2"; shift
                ;;
            --gpu)
                [ $# -ge 2 ] || _error "--gpu requires a value"
                [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 10 ] && [ "$2" -le 100 ] || _error "--gpu: invalid percentage '$2'"
                gpu_pct="$2"; shift
                ;;
            *)
                if [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 10 ] && [ "$1" -le 100 ] && [ -z "$positional" ]; then
                    positional="$1"
                else
                    _error "invalid argument: $1"
                fi
                ;;
        esac
        shift
    done

    [ -z "$cpu_pct" ] && [ -n "$positional" ] && cpu_pct="$positional"
    [ -z "$gpu_pct" ] && [ -n "$positional" ] && gpu_pct="$positional"

    if [ -z "$cpu_pct" ] && [ -z "$gpu_pct" ]; then
        _show_status
        exit 0
    fi

    [ -n "$cpu_pct" ] && _apply_cpu "$cpu_pct"
    [ -n "$gpu_pct" ] && _apply_gpu "$gpu_pct"

    local log_msg=""
    [ -n "$cpu_pct" ] && log_msg="CPU@${cpu_pct}%"
    [ -n "$gpu_pct" ] && log_msg="${log_msg:+$log_msg, }GPU@${gpu_pct}%"
    _info "$log_msg"
}

main "$@"

{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true, "prune": true },
  "default_agent": "plan",
  "lsp": true,
  "permission": {
    "read": {
      "**/.env": "allow",
      "**/.env.*": "allow"
    },
    "bash": {
      "sudo": "deny",
      "sudo *": "deny",
      "rm -rf": "deny",
      "rm -rf *": "deny"
    },
    "firefox-devtools_*": "deny"
  },
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "@mozilla/firefox-devtools-mcp@latest",
        "--",
        "--headless",
        "--viewport",
        "1280x720"
      ]
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ]
}

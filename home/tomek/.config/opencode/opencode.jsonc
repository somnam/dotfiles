{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true, "buffer": "75%" },
  "default_agent": "plan",
  // "agents": {
  //   "plan":       { "model": "provider/top#high" },
  //   "build":      { "model": "provider/balanced#high" },
  //   "general":    { "model": "provider/balanced#high" },
  //   "explore":    { "model": "provider/efficient#high" },
  //   "browser":    { "model": "provider/efficient#high" },
  //   "title":      { "model": "provider/efficient#low" },
  //   "summary":    { "model": "provider/efficient#high" },
  //   "compaction": { "model": "provider/balanced#high" }
  // },
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/workspace/*", "effect": "allow" },
    { "action": "edit", "resource": "~/workspace/*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.cache/*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "firefox-devtools_*", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "@mozilla/firefox-devtools-mcp@latest",
          "--",
          "--headless",
          "--viewport",
          "1280x720"
        ]
      }
    }
  },
  "tool_output": { "max_lines": 1500, "max_bytes": 38400 },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "plugins": [
  ]
}

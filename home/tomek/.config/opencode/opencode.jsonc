{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true },
  "default_agent": "plan",
  "lsp": true,
  "permissions": [
    { "action": "read", "resource": "**/.env", "effect": "allow" },
    { "action": "read", "resource": "**/.env.*", "effect": "allow" },
    { "action": "shell", "resource": "sudo", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.cache", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.cache/**", "effect": "deny" },
    { "action": "prune", "resource": "*", "effect": "allow" },
    { "action": "firefox-devtools_*", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "@mozilla/firefox-devtools-mcp@latest",
          "--",
          "--headless",
          "--viewport",
          "1280x720"
        ]
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "plugins": [
    "opencode-dcp@2.0.0-beta.13"
  ]
}
